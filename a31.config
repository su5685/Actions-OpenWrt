CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_konka_komi-a31=y
CONFIG_LINUX_6_12=y
CONFIG_USE_APK=y
CONFIG_LUCI_LANG_zh_Hans=y                         # 简体中文（zh-cn）
# CONFIG_LUCI_LANG_zh_Hant is not set              # 繁体中文
CONFIG_PACKAGE_luci=y                              # LuCI 元包
CONFIG_PACKAGE_luci-app-firewall=y                 # 防火墙
CONFIG_PACKAGE_luci-app-package-manager=y          # 软件包（IM 特有，配合 apk）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y              # 基础中文包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y          # 防火墙中文包
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y   # 软件包中文包
CONFIG_PACKAGE_curl=y                              # 阿里ddns依赖
CONFIG_PACKAGE_openssl-util=y                      # 阿里ddns依赖
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_conntrack=y                         # mwan3依赖
CONFIG_PACKAGE_ip-full=y                           # mwan3依赖
CONFIG_PACKAGE_iptables-nft=y                      # 连接数限制依赖
CONFIG_PACKAGE_kmod-ipt-conntrack=y                # 连接数限制依赖
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y      # 连接数限制依赖 
CONFIG_PACKAGE_telnet-bsd=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=n
