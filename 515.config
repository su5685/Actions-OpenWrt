# ============================================================
# 目标平台 & 机型选择
# ============================================================
CONFIG_TARGET_airoha=y                  # 目标平台：Airoha ARM64 架构
CONFIG_TARGET_airoha_an7581=y           # 子目标：AN7581 芯片方案
CONFIG_TARGET_MULTI_PROFILE=y           # 启用多机型编译模式
CONFIG_TARGET_PER_DEVICE_ROOTFS=y       # 为每个设备生成独立根文件系统
# 指定编译机型：ZNXT ZN515XG-D，身份校准数据分区为 reservearea
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d=y

# ============================================================
# PON 光模块驱动 & 用户态程序（光猫核心，默认不开启，必须手动选中）
# ============================================================
CONFIG_PACKAGE_kmod-airoha-xpon=y            # PON MAC 驱动，PON 数据通道核心
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y    # 光前端驱动，负责光功率、温度、校准数据读写
CONFIG_PACKAGE_airoha-pond=y                 # OMCI/OAM 协议守护进程，完成 ONU 注册、LOID 认证
CONFIG_PACKAGE_airoha-ponctl=y               # PON 命令行工具，查看光模块状态
CONFIG_PACKAGE_luci-app-pon=y                # LuCI PON 管理页面，可编辑 SN/MAC/LOID
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y         # PON 页面中文翻译

# ============================================================
# 硬件专属驱动（默认不编译进固件）
# ============================================================
CONFIG_PACKAGE_kmod-airoha-en7572=y           # EN7572 光前端芯片驱动（ZN515 板载光器件）
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y   # AN7581 NPU 固件，硬件转发卸载前提
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y      # EN8811H 2.5G PHY 驱动
CONFIG_PACKAGE_airoha-en8811h-firmware=y      # EN8811H PHY 固件
CONFIG_PACKAGE_znxt-zn515-mt7916-eeprom=y     # ZN515 专用 MT7916 无线 EEPROM 模板，缺此无线无法正常启动

# ============================================================
# MT7916D WiFi 驱动（基座默认编译为模块 =m，这里改为内置 =y）
# ============================================================
CONFIG_PACKAGE_kmod-mt76-core=y       # MT76 无线驱动核心
CONFIG_PACKAGE_kmod-mt76-connac=y     # ConnAc 协议支持，MT7916 依赖此模块
CONFIG_PACKAGE_kmod-mt7915e=y         # MT7915/MT7916 无线驱动
CONFIG_PACKAGE_kmod-mt7916-firmware=y # MT7916 无线固件
CONFIG_PACKAGE_wpad-openssl=y         # WPA 认证组件，hostapd + wpa_supplicant 合一

# ============================================================
# USB 控制器（ZN515 自带 USB1 + USB2 双接口）
# ============================================================
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y     # MTK/Airoha 平台 xHCI 控制器驱动，USB 正常工作的关键
CONFIG_PACKAGE_kmod-usb3=y             # USB3.0 核心驱动

# ============================================================
# 网络转发优化（nftables 硬件 offload、全锥 NAT）
# ============================================================
CONFIG_PACKAGE_kmod-nft-fullcone=y       # 全锥形 NAT，游戏、PT 下载更友好
CONFIG_PACKAGE_kmod-nft-offload=y       # nftables 流卸载，转发流量交由硬件 PPE 处理
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y # 桥接连接跟踪，IPTV 桥接、二层转发需要

# ============================================================
# LuCI 界面语言 & 主题
# ============================================================
CONFIG_LUCI_LANG_zh_Hans=y              # 开启简体中文语言包总开关
CONFIG_PACKAGE_luci=y                              # LuCI 元包
CONFIG_PACKAGE_luci-app-firewall=y                 # 防火墙
CONFIG_PACKAGE_luci-app-package-manager=y          # 软件包（IM 特有，配合 apk）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y              # 基础中文包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y          # 防火墙中文包
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y   # 软件包中文包
# CONFIG_PACKAGE_luci-theme-argon=y       # Argon 主题

# ============================================================
# Airoha 硬件状态监控页面（默认不开启）
# ============================================================
CONFIG_PACKAGE_luci-app-airoha-npu=y        # SoC/NPU 状态页面，查看 CPU、NPU 流表、转发状态
# Airoha 硬件状态监控页面 依赖补齐
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_DEFAULT_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
# CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y # NPU 页面中文翻译
# CONFIG_PACKAGE_luci-app-pon-status=y        # PON 光模块状态卡片，显示收发光、温度、电流

# ============================================================
# TF-A 引导固件（AN7581 启动必需）
# ============================================================
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2=y  # TF-A BL2 阶段固件
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl31=y # TF-A BL31 阶段固件

# ============================================================
# 系统升级组件
# ============================================================
CONFIG_PACKAGE_fitblk=y # FIT 镜像解析工具，sysupgrade 刷写 .itb 固件依赖

# ============================================================
# 用户自选功能组件
# ============================================================
CONFIG_PACKAGE_curl=y                              # 阿里ddns依赖
CONFIG_PACKAGE_openssl-util=y                      # 阿里ddns依赖
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-i18n-https-dns-proxy-zh-cn=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_conntrack=y                         # mwan3依赖
CONFIG_PACKAGE_ip-full=y                           # mwan3依赖
CONFIG_PACKAGE_iptables-nft=y                      # 连接数限制依赖
CONFIG_PACKAGE_kmod-ipt-conntrack=y                # 连接数限制依赖
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y      # 连接数限制依赖 
CONFIG_PACKAGE_telnet-bsd=y                        # 光猫重启依赖
CONFIG_PACKAGE_luci-proto-wireguard=y
